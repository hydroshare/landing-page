:80 {
    root * /usr/share/caddy
    encode gzip zstd
    
    # Serve static files
    file_server
    
    # For Vue Router history mode
    @notStatic {
        file {
            try_files {path} /index.html
        }
    }
    
    rewrite @notStatic /index.html
    
    # Handle /landing/GUID pattern
    try_files {path} /landing/{path} /index.html
}