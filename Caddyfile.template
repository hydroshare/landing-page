:80 {
    # Handle the base path
    handle_path {{ .BASE_PATH }}* {
        root * /srv/landing
        try_files {path} /index.html
        file_server
    }
    
    # Redirect root to base path
    redir / {{ .BASE_PATH }}
    
    # Enable gzip
    encode gzip
    
    # Security headers
    header {
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        X-XSS-Protection "1; mode=block"
    }
    
    # Logging
    log {
        output stdout
        format console
    }
}